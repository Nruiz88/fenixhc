# ============================================================
# FENIX ROLLER HOCKEY - MariaDB (Coolify)
# Copiar a .env.local y completar
# ============================================================

# Host de la base de datos.
# - Local: localhost
# - Coolify: nombre del servicio/container de la DB (ej: mariadb-fenix)
DB_HOST=localhost
DB_PORT=3306
DB_USER=fenix
DB_PASSWORD=cambiar-esta-clave
DB_NAME=club_fenix

# Secreto para los JWT de sesión (cambiar en producción)
JWT_SECRET=cambiar-este-secreto

# Carpeta donde se guardan los archivos subidos (opcional)
# UPLOAD_DIR=/var/fenix-uploads

# --- Verificación de email (Resend) ---
# Sin RESEND_API_KEY el envío es un no-op: el registro funciona pero no sale
# email, y la app muestra el link de verificación en pantalla (solo dev).
# Para producción hace falta una key de https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Remitente. En Resend el dominio tiene que estar verificado.
# EMAIL_FROM=Fenix Roller Hockey <noreply@tudominio.com.ar>

# --- Plantillas de correo en Resend ---
# Los HTML de referencia viven en `emails/` y son la fuente de la verdad para
# reproducir o auditar un correo. La directiva puede editarlos en el dashboard
# de Resend sin deploy.
#
# OJO: si estas variables NO estan definidas, la app manda el HTML embebido de
# src/lib/email.ts. Ese es el camino que no puede romperse, y es el que
# sostiene el enlace de verificacion y el de recuperacion de clave.
# RESEND_TEMPLATE_VERIFICACION=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RESEND_TEMPLATE_RECUPERACION=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RESEND_TEMPLATE_AVISO=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Archivos: disco o S3/R2 ---
# Con las tres primeras, los archivos se guardan en el bucket. Sin ellas, en
# disco bajo UPLOAD_DIR.
# S3_BUCKET=fenix
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# Origen público de la app, para armar los links de verificación.
# En producción (Coolify/Traefik) es obligatorio: sin esto el link del email
# puede armarse con el host interno y no abrir.
# (sin prefijo NEXT_PUBLIC_ a propósito: esa se inlinea al buildear y no
#  llegaría al bundle si la variable se agrega después del deploy)
APP_URL=https://clubhockey.com.ar
